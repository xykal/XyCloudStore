# XyCloudStore Dashboard — Next.js 16 terbaru — Built-in XyVerse
NEXT_PUBLIC_API_BASE=https://api.xycloud.my.id
# Turnstile (Cloudflare) — dari kuncikerjasama.txt XYDESK ADMIN WEB, reuse untuk XyCloud admin
# Sitekey publik — aman di frontend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE6jQZaig7vJKhQs
# hCaptcha alternatif (opsional)
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
# Worker secret (jangan taruh di frontend, set via wrangler secret put):
# TURNSTILE_SECRET=0x4AAAAAAE6jQUEAC9vxs3Ux4qu3BH0P8iI
# HCAPTCHA_SECRET=xxx
